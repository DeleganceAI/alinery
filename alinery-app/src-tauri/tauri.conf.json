{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alinery",
  "version": "0.25.0",
  "identifier": "ai.delegance.alinery",
  "build": {
    "beforeDevCommand": "bash src-tauri/scripts/copy-sidecar.sh debug && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && bash src-tauri/scripts/copy-sidecar.sh release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Alinery",
        "width": 1200,
        "height": 800,
        "maximized": true,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "resources/ownership/": "ownership/"
    },
    "externalBin": ["alinery-vinculum-daemon", "alinery-mcp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
