        "dock_badge_completions": true,
        "dock_badge_failures": false,
        "dock_badge_input_waits": true,
        "enabled": false,
        "sound": true
      },
      "provenance": {
        "defaults": {
          "draft_autosave": "global",
          "harness": "global",
          "model": "global",
          "playbook": "global",
          "thinking": "global"
        },
        "github_token": "global"
      },
      "telemetry": {
        "enabled": true,
        "endpoint": "http://127.0.0.1:9",
        "install_id": "11111111-2222-3333-4444-555555555555",
