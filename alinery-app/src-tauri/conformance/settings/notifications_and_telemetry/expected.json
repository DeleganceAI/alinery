        "message_adapter": "unsupported",
        "model_arg": [],
        "models": [],
        "models_cmd": "",
        "name": "Terminal",
        "prompt_arg": [],
        "prompt_injection": "",
        "resume": null,
        "source": "global"
      },
      {
        "adapter": "vinculum",
        "args": [],
        "binary": "vinculum",
        "env": {},
        "key": "vinculum",
        "message_adapter": "vinculum_bracketed_paste",
        "model_arg": [
          "--model={model}"
        ],
        "models": [],
        "models_cmd": "{binary} models --json 2>/dev/null | grep -oE '\"selector\":\"[^\"]*\"' | cut -d'\"' -f4",
        "name": "Vinculum",
        "prompt_arg": [
          "--",
          "{prompt}"
        ],
        "prompt_injection": "arg",
        "resume": {
          "enabled": true,
          "id_source": "manual",
          "launch_args": [],
          "resume_args": [
            "--resume={resume_token}"
          ]
        },
        "source": "global"
