# Generated by Cargo
# will have compiled files and executables
# No trailing slash: a trailing-slash pattern only matches directories, so a stray symlink named
# `target` (mode 120000) can slip past it and land in the index, dangling on every other checkout.
/target

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Tauri sidecars (built by scripts/copy-sidecar.sh)
/alineryd-*
/alinery-mcp-*
/alinery-runner-*
/alinery-vinculum-daemon-*
/resources/ownership/
/resources/remote/
