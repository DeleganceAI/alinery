{
  "name": "alinery-app",
  "private": true,
  "version": "0.25.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:omp-extension && tsc && vite build",
    "preview": "vite preview",
    "lint": "biome check . --diagnostic-level=error",
    "lint:all": "biome check . --max-diagnostics=500",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:omp-extension": "echo 'OMP runner is gone; its extension leaves with it' && exit 0",
    "smoke:omp-completion": "echo 'OMP runner is gone; Vinculum completes phases in process' && exit 0",
    "omp:fetch": "../scripts/dev-fetch-omp.sh",
    "omp:check": "../scripts/dev-fetch-omp.sh --check",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "alinery-proto": "file:../proto",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "thinking-orbs": "^0.3.1",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
